{
  "$说明": [
    "项目级注册片段 —— 合并进 <项目>/.claude/settings.json（**合并**，不要覆盖）。",
    "⚠️ 项目级只在 cwd 是本项目时生效（settings 无父目录回退）。",
    "⚠️ 覆盖'别的项目里的 Agent'只能靠用户级，见 settings.user.json。",
    "⚠️ 改完必须**重启会话**才生效 —— settings 是会话启动时读的。"
  ],

  "hooks": {
    "PreToolUse": [
      {
        "$说明": "① 对外/不可逆动作门  ② 批量改写门   —— 都只挂 Bash",
        "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/outward-guard.py\"",
            "timeout": 10 },
          { "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bulk-write-guard.py\"",
            "timeout": 10 }
        ]
      },
      {
        "$说明": "③ 路径白名单门 —— 必须挂 7 个工具：Read/Write/Edit 不走 Bash，只挂 Bash 等于没挂",
        "matcher": "Bash|Read|Write|Edit|NotebookEdit|Glob|Grep",
        "hooks": [
          { "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/path-guard.py\"",
            "timeout": 10 }
        ]
      }
    ]
  }
}
